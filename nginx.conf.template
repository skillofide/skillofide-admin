server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA: everything that isn't a real file falls back to index.html so
    # client-side routes (/users, /tests/:id, …) resolve.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy all API traffic to the gateway. API_UPSTREAM is injected at container
    # start (docker envsubst); defaults to the api-gateway service on the network.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
